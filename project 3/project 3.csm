DESPMTR headr 0.2

MARK
SPHERE 0 0 0 headr
ATTRIBUTE _color $cyan
cylinder 0 0 -0.1 0 0 -1 headr
ATTRIBUTE _color $red
UNION
STORE human


   

DIMENSION fuselage:noselist  2                 4  1

DESPMTR   fuselage:noselist  ".5; 0; 1; 0;\
                              .5; 0; 0; 1;"


DESPMTR wingspan 10.8
DESPMTR dihedral 7
DESPMTR S 12.8
SET AR (wingspan^2)/S
DESPMTR fuselength 7.3
DESPMTR wingLoc 2.2

DESPMTR fuseDiameter 0.7
SET wingzLoc -fuseDiameter+.2
   
set chord S/wingspan
outpmtr chord chord


# Design Parameters for structure
SET   wing:spar1     0.20      # location of fwrd spar
SET   wing:spar2     0.70      # location of rwrd spar
CFGPMTR   wing:nrib      3.00       # number of ribs per wing
SET  wing:ytip   wingspan/2
SET  wing:xtip   0          # no sweep in your wing, so xtip = 0


SET htail:AR 3
SET htail:S  0.5*chord*S/(0.5*fuselength)
outpmtr htail:S htail:S
SET htail:span  (htail:AR*htail:S)^0.5
outpmtr htail:span htail:span
SET htail:chord htail:S/htail:span
OUTPMTR htail:chord htail:chord


SET sweep 30
SET vtail:AR 1.5
set taper 0.7
SET vtail:S  0.04*wingspan*S/(0.5*fuselength)
outpmtr vtail:S vtail:S

SET vtail:height (vtail:AR*vtail:S)^0.5
SET vtail:rchord (2*vtail:S)/(vtail:height*(1+taper))
OUTPMTR vtail:rchord vtail:rchord# cr
SET vtail:tchord taper*vtail:rchord                 # ct
SET vtail:mc (vtail:rchord+vtail:tchord)/2

SET vtail:tipX vtail:height/2*sind(sweep)

SET     wtipz      0+4/2*tand(dihedral)

UDPRIM naca series 2412
SCALE chord 
ROTATEX 90
STORE airfoil

#makes wing 
MARK
RESTORE airfoil 
TRANSLATE 0 -wingspan/2 wtipz   
RESTORE airfoil
   
RESTORE airfoil 
TRANSLATE 0 wingspan/2 wtipz 
RULE

STORE wing 
   
#makes wingFUEL
   

   
MARK
RESTORE airfoil 
TRANSLATE 0 -wingspan/4 wtipz/2  
RESTORE airfoil
   
RESTORE airfoil 
TRANSLATE 0 wingspan/4 wtipz/2
RULE  
SCALE 0.85
SELECT FACE 
ATTRIBUTE _color $black

   
STORE fuel

 

# make wing waffle
RESTORE   wing
SET       xmin       @xmin-0.1
SET       xmax       @xmax+0.1
SET       ymin       0
SET       ymax       @ymax+0.1
SET       zmin       @zmin-0.1
SET       zmax       @zmax+0.1
STORE     .

UDPARG    waffle     depth wing:nrib     # ensures rebuild
UDPARG    waffle     depth wing:spar1
UDPARG    waffle     depth wing:spar2
UDPRIM    waffle     depth zmax-zmin  filename <<

    # construction lines for spars
    CPOINT A   AT          0+wing:spar1*chord 0
    CPOINT B   AT  wing:xtip+wing:spar1*chord -wing:ytip
    CPOINT C   AT          0+wing:spar2*chord 0
    CPOINT D   AT  wing:xtip+wing:spar2*chord -wing:ytip

    CLINE  AB      A  B
    CLINE  CD      C  D

    # rite spars
    POINT  E   ON  AB   YLOC  ymin
    POINT  F   ON  AB   YLOC  ymax
    LINE   EF  E   F  tagComp=riteWing  tagType=spar tagIndex=2
    POINT  G   ON  CD   YLOC  ymin
    POINT  H   ON  CD   YLOC  ymax
    LINE   GH  G   H  tagComp=riteWing  tagType=spar tagIndex=2

    # rite ribs
    PATBEG  irib  wing:nrib
        CPOINT  I  AT  xmin  -wing:ytip*irib/(wing:nrib+1)
        CPOINT  J  AT  xmax  y@I
        LINE    .   I  J  tagComp=riteWing  tagType=rib   tagIndex=!val2str(irib,0)
    PATEND

    # root rib
    CPOINT  I  AT  xmin  0
    CPOINT  J  AT  xmax  y@I
    LINE    .   I  J  tagComp=rootWing  tagType=rib   tagIndex=0

    # left spars
    POINT  E   AT  x@E  -y@E
    POINT  F   AT  x@F  -y@F
    LINE   EF  E   F  tagComp=leftWing  tagType=spar  tagIndex=1

    POINT  G   AT  x@G  -y@G
    POINT  H   AT  x@H  -y@H
    LINE   GH  G   H  tagComp=leftWing  tagType=spar tagIndex=2

    # left ribs
    PATBEG  irib  wing:nrib
        CPOINT  I  AT  xmin  wing:ytip*irib/(wing:nrib+1)
        CPOINT  J  AT  xmax  y@I
        LINE    .   I  J  tagComp=leftWing  tagType=rib   tagIndex=!val2str(irib,0)
    PATEND
>>
TRANSLATE  0  0  zmin
STORE     WingWaffle

# trim the waffle to be the ribs and spars
RESTORE   wing
RESTORE   WingWaffle
INTERSECT
TRANSLATE wingLoc 0 wingzLoc

# score the wing skin with the waffle
RESTORE   wing
TRANSLATE wingLoc 0 wingzLoc

RESTORE fuel   
TRANSLATE wingLoc+.05 0 wingzLoc
   
MARK

#POINT 0 0 -.1
UDPRIM supell rx fuseDiameter/3.5 ry fuseDiameter/2.5 n 3
ROTATEY 90 0 0
TRANSLATE 0 0 -.075
   
UDPRIM supell rx_e fuseDiameter/1.35 rx_w fuseDiameter/3  ry fuseDiameter/1.5 n 3
ROTATEY 90 0 0
TRANSLATE fuselength/50 0 0
   
UDPRIM supell rx_e fuseDiameter/1.1 rx_w fuseDiameter/2 ry fuseDiameter/1.15 n 3
ROTATEY 90 0 0
TRANSLATE fuselength/10 0 0
   

UDPRIM supell rx fuseDiameter/1.08  ry fuseDiameter/1.08 n 3
ROTATEY 90 0 0
TRANSLATE (fuselength/6) 0 0
   
   
UDPRIM supell rx fuseDiameter/1.1  ry fuseDiameter/1.1
ROTATEY 90 0 0
TRANSLATE (fuselength/2) 0 0.2   
   

UDPRIM supell rx fuseDiameter/2.5  ry fuseDiameter/3
ROTATEY 90 0 0
TRANSLATE (fuselength) 0 0.25    
 

BLEND #fuselage:noselist   

STORE fuselage
RESTORE fuselage
SELECT face
ATTRIBUTE _trn $off

   
RESTORE human 
TRANSLATE 2 0.25 0.5  
RESTORE human 
TRANSLATE 2 -0.25 0.5      
   
RESTORE human 
TRANSLATE 1.25+headr 0.25 0.5     
   
RESTORE human 
TRANSLATE 1.25+headr -0.25 0.5  
   
##### view cone ####
#cone 1.25 -0.25 0.55 0 -0.25 0.55  0.35
#STORE view
#RESTORE view
#SELECT face
#ATTRIBUTE _color $red
#ATTRIBUTE _trn $on
   
UDPRIM naca series 0010
scale htail:chord  
ROTATEX 90
STORE hfoil

MARK
RESTORE hfoil
SET htailLoc 0.051+fuselength-htail:chord  
OUTPMTR htailLoc htailLoc   
TRANSLATE htailLoc -htail:span fuseDiameter/2.5
RESTORE hfoil
TRANSLATE fuselength-htail:chord htail:span fuseDiameter/2.5
RULE
STORE htail
RESTORE htail

UDPRIM naca series 0010
STORE vfoil


MARK
RESTORE vfoil
scale vtail:rchord  
SET vtailLoc fuselength-vtail:rchord  
OUTPMTR vtailLoc vtailLoc   
TRANSLATE vtailLoc 0 fuseDiameter/1.3
RESTORE vfoil
SCALE vtail:tchord 
TRANSLATE fuselength-vtail:rchord+vtail:tipX 0 vtail:height+fuseDiameter/1.3
RULE
STORE vtail
RESTORE vtail



  ################################## make the propeller ###########################
UDPARG    prop      nblade     2
UDPARG    prop      cpower     0.2969
UDPARG    prop      lambda     0.3
UDPARG    prop      reyr       2.95e+6
UDPARG    prop      rtip       .75 #ft
UDPARG    prop      rhub       0.2   # ft
UDPARG    prop      clift      1
UDPARG    prop      cdrag      0.075
UDPARG    prop      alfa       .25   # deg

# shaft/spinner parameters (all dimensions in ft)
UDPARG    prop      shdiam     .15
UDPARG    prop      shxmin     0
UDPARG    prop      shxmax     0.15
UDPARG    prop      spdiam     0.25
UDPARG    prop      spxmin     -.5

UDPRIM    prop
TRANSLATE  -.05 0 0
ROTATEX 20 0 0

   
 # LANDING GEAR
CYLINDER 0 0 0 0 0 -0.5 .075
TRANSLATE 0.25 0 -fuseDiameter/1.25
CYLINDER 0 -1.4 0 0 -1.4 -0.5 .075
TRANSLATE 3 0 -fuseDiameter/1.6
CYLINDER 0 1.4 0 0 1.4 -0.5 .075
TRANSLATE 3 0 -fuseDiameter/1.6

#wheel
CYLINDER 0 -.1 0 0 .1 0 .1
STORE wheel
RESTORE wheel
TRANSLATE 0.25 0 (-fuseDiameter/1.25)-0.4
RESTORE wheel
TRANSLATE 3 -1.4 (-fuseDiameter/1.25)-0.4
RESTORE wheel
TRANSLATE 3 1.4 (-fuseDiameter/1.25)-0.4

CYLINDER .25 0 -.15 1 0 -.15 .4
SELECT face
ATTRIBUTE _color $red


#MARK
#UDPRIM supell rx_e fuseDiameter/1.1 rx_w fuseDiameter/2 ry fuseDiameter/1.15 
#ROTATEY 90 0 0
#TRANSLATE wingLoc-fuselength/20 0 0
   

#UDPRIM supell rx fuseDiameter  ry fuseDiameter
#ROTATEY 90 0 0
#TRANSLATE (fuselength/30)+wingLoc 0 0
   
   
#UDPRIM supell rx fuseDiameter/1.1  ry fuseDiameter/1.1
#ROTATEY 90 0 0
#TRANSLATE (fuselength/2) 0 0
#BLEND
#SCALE 0.9
#TRANSLATE 0.25 0 0 
#SELECT face
#ATTRIBUTE _color $blue


MARK
UDPRIM supell rx fuseDiameter/1  ry fuseDiameter/1 n 3
ROTATEY 90 0 0
TRANSLATE 2.5 0 .25
   
UDPRIM supell rx fuseDiameter/1.5  ry fuseDiameter/2 n 3
ROTATEY 90 0 0
TRANSLATE 4 0 0.25    
BLEND
SCALE 0.9
TRANSLATE 0.5 0 0 
SELECT face
ATTRIBUTE _color $cyan
